# ==========================================================================
#  git - keep line endings sane across platforms
# ==========================================================================
* text=auto

*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf

*.bat   text eol=crlf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.onnx  binary
*.woff  binary
*.woff2 binary
