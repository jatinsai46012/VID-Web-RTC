# ===========================================================================
#  VID - deployment configuration
#
#  Copy this file to `.env` (same directory, next to docker-compose.yml) and
#  fill it in. `.env` is gitignored - the real values never leave the server.
#
#      cp .env.example .env
#
#  docker-compose.yml reads these for variable interpolation only; they are
#  passed to the containers through the explicit `environment:` block.
# ===========================================================================

# --- required ---------------------------------------------------------------

# Public hostname, no scheme. Required: it selects the nginx server_name, the
# Let's Encrypt certificate path, and the HTTP->HTTPS redirect target.
# No domain yet? A free duckdns.org subdomain takes about two minutes and
# works exactly the same - just point its A record at the server's public IP.
DOMAIN=vid.example.com

# Where Let's Encrypt sends expiry notices. Must be a real, monitored inbox.
CERT_EMAIL=you@example.com

# Signs every JWT. Any long random string works; rotating it logs everyone
# out at once. Generate one with:  openssl rand -hex 32
JWT_SECRET=


# --- admin account (seeded on first boot) -----------------------------------

# server.py creates this account if it does not exist yet, and keeps the
# password in sync on every boot. It gates /api/source/download.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Extra addresses treated as admin, comma separated.
ADMIN_EMAILS=


# --- email / OTP login ------------------------------------------------------
# Leave SMTP_* empty to disable email login entirely - password login still
# works, so the site stays usable. Fill them in to enable one-time codes.
#
# Gmail app password (2-Step Verification -> App passwords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=true

EMAIL_FROM_NAME=VID
EMAIL_REPLY_TO=


# --- database ---------------------------------------------------------------
DB_NAME=hackpass


# --- CORS -------------------------------------------------------------------
# Leave empty. The production build is served from the same origin as the API
# (REACT_APP_BACKEND_URL is baked in as ""), so the browser never makes a
# cross-origin request and CORS does not apply. Only set this if you ever host
# the frontend somewhere else, e.g.:
#   CORS_ORIGINS=https://vid.example.com
CORS_ORIGINS=


# --- model weights ----------------------------------------------------------
# Fetched once on first boot into the `model-data` volume, SHA-256 verified,
# and reused across rebuilds. Defaults in docker-compose.yml already point at
# the v1.0.0 release; override only if you republish the weights.
#MODEL_URL=https://github.com/jatinsai46012/VID-Web-RTC/releases/download/v1.0.0/best_model.onnx
#MODEL_SHA=30FFE8F5B73A68420337D13172E306692CC679D1BCAC9404BFFA542D945EBDF6

# Set to 1 to run without the ONNX classifier (heuristics only). Useful for
# smoke-testing the stack before the release asset has been uploaded.
#VID_SKIP_MODEL_DOWNLOAD=1
