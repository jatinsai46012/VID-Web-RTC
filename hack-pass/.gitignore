# ==========================================================================
#  git - keep the repository (and therefore the Render build context) lean
# ==========================================================================

# ---- Python ---------------------------------------------------------------
.venv/
**/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---- Node -----------------------------------------------------------------
node_modules/
build/
.yarn/
yarn-error.log

# ---- Secrets / local config ----------------------------------------------
.env
.env.*
!.env.example

# ---- Large model artifact (GitHub rejects files > 100 MB) ------------------
*.onnx

# ---- Editor / OS junk -----------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Local tooling --------------------------------------------------------
logs/
